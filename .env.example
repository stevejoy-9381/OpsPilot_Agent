# PostgreSQL bootstrap credentials. Local synthetic lab only; never use real secrets.
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=opspilot

# SQLAlchemy connection URL for the API and agent processes.
DATABASE_URL=postgresql://opspilot:change-me-local-only@127.0.0.1:5432/opspilot

# Redis connection URL for short-lived run and approval state.
REDIS_URL=redis://127.0.0.1:6379/0

# Gemini API key. Leave empty in the committed example; set it only in local .env.
GEMINI_API_KEY=

# Gemini model identifier used by the model adapter (configured in Phase 0.7).
GEMINI_MODEL=replace-with-supported-model

# Hard cap on tool calls per investigation run.
MAX_TOOL_CALLS=8

# Wall-clock limit for one investigation run, in seconds.
RUN_TIMEOUT_SECONDS=120

# How long an approval remains valid, in seconds.
APPROVAL_TTL_SECONDS=900

# Python log level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO
