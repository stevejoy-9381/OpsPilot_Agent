# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin broker

COPY --from=ghcr.io/astral-sh/uv:0.6.14 /uv /uvx /bin/

COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra broker --no-install-project

COPY apps/api/__init__.py apps/api/__init__.py
COPY apps/api/logging.py apps/api/logging.py
COPY apps/api/domain/ apps/api/domain/
COPY apps/api/models/ apps/api/models/
COPY apps/api/repositories/ apps/api/repositories/
COPY apps/api/services/run_service.py apps/api/services/run_service.py
COPY apps/api/services/__init__.py apps/api/services/__init__.py
COPY broker/ broker/
COPY shared/ shared/
COPY config/lab_targets.yaml config/lab_targets.yaml

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra broker && \
    chown -R 10001:10001 /app

USER 10001:10001

HEALTHCHECK --interval=5s --timeout=3s --retries=10 --start-period=5s \
    CMD ["uv", "run", "--no-sync", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/healthz', timeout=2)"]

CMD ["uv", "run", "--no-sync", "python", "-m", "broker.main"]
